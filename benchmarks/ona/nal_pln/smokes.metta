;; ONA examples/nal/smokes.nal
!(import! &self /nexus/Dev/OpenCog/NL2PLN_Project/PeTTaChainer/pettachainer/metta/petta_chainer)
!(compileadd kb (: r1 (Implication (Smokes $x) (Cancerous $x)) (STV 0.6 0.9)))
!(compileadd kb (: r2 (Implication (And (Smokes $y) (Friend $x $y)) (Smokes $x)) (STV 1.0 0.9)))
!(compileadd kb (: r3 (Implication (And (Smokes $y) (Friend $y $x)) (Smokes $x)) (STV 1.0 0.9)))
!(compileadd kb (: f1 (Friend Anna Bob) (STV 1.0 0.9)))
!(compileadd kb (: f2 (Friend Anna Edward) (STV 1.0 0.9)))
!(compileadd kb (: f3 (Friend Anna Frank) (STV 1.0 0.9)))
!(compileadd kb (: f4 (Friend Edward Frank) (STV 1.0 0.9)))
!(compileadd kb (: f5 (Friend Gary Helen) (STV 1.0 0.9)))
!(compileadd kb (: f6 (Friend Gary Frank) (STV 0.0 0.9)))
!(compileadd kb (: f7 (Smokes Anna) (STV 1.0 0.9)))
!(compileadd kb (: f8 (Smokes Edward) (STV 1.0 0.9)))
;; expected (NAL): every person cancerous f=0.6; confidences Edward .497 Anna .489 Bob .396 Frank .403 Gary .200 Helen .162
!(query 100 kb (: $p (Cancerous Edward) $tv))
!(query 100 kb (: $p (Cancerous Anna) $tv))
!(query 100 kb (: $p (Cancerous Bob) $tv))
!(query 100 kb (: $p (Cancerous Frank) $tv))
!(query 100 kb (: $p (Cancerous Gary) $tv))
!(query 100 kb (: $p (Cancerous Helen) $tv))
!(query 100 kb (: $p (Cancerous $who) $tv))
