;; ONA examples/nal/reasoningbench.nal. NAL asks "<(x * y) --> ?1>?" (which relation); PeTTaChainer has no
;; predicate-variable query, so the expected relation is asked directly (easier than the original).
!(import! &self /nexus/Dev/OpenCog/NL2PLN_Project/PeTTaChainer/pettachainer/metta/petta_chainer)
;; The succ chain (term-growing rule) is in reasoningbench_num.metta: it does not finish within the timeout.
!(compileadd kb (: r1 (Implication (Green $x) (Flower $x)) (STV 1.0 0.9)))
!(compileadd kb (: r2 (Implication (Red $x) (Flower $x)) (STV 1.0 0.9)))
!(compileadd kb (: r3 (Implication (And (Father $x $y) (Father $y $z)) (Grandfather $x $z)) (STV 1.0 0.9)))
!(compileadd kb (: r4 (Implication (And (Father $x $y) (Mother $y $z)) (Grandfather $x $z)) (STV 1.0 0.9)))
!(compileadd kb (: r5 (Implication (And (Mother $x $y) (Father $y $z)) (Grandmother $x $z)) (STV 1.0 0.9)))
!(compileadd kb (: r6 (Implication (And (Mother $x $y) (Mother $y $z)) (Grandmother $x $z)) (STV 1.0 0.9)))
!(compileadd kb (: r7 (Implication (Grandfather $x $y) (Grandchild $y $x)) (STV 1.0 0.9)))
!(compileadd kb (: r8 (Implication (Grandmother $x $y) (Grandchild $y $x)) (STV 1.0 0.9)))
!(compileadd kb (: f1 (Green rose) (STV 1.0 0.9)))
!(compileadd kb (: f2 (Red rose) (STV 1.0 0.9)))
!(compileadd kb (: f3 (Green grass) (STV 1.0 0.9)))
!(compileadd kb (: f4 (Father sam_father sam) (STV 1.0 0.9)))
!(compileadd kb (: f5 (Father sam_father_father sam_father) (STV 1.0 0.9)))
!(compileadd kb (: f6 (Mother sam_father_mother sam_father) (STV 1.0 0.9)))
!(compileadd kb (: f7 (Mother sam_mother sam) (STV 1.0 0.9)))
!(compileadd kb (: f8 (Mother sam_mother_mother sam_mother) (STV 1.0 0.9)))
!(compileadd kb (: f9 (Father sam_mother_father sam_mother) (STV 1.0 0.9)))
!(query 100 kb (: $p (Grandfather sam_father_father sam) $tv))
!(query 100 kb (: $p (Grandchild sam sam_father_father) $tv))
!(query 100 kb (: $p (Grandfather sam_mother_father sam) $tv))
!(query 100 kb (: $p (Grandchild sam sam_mother_father) $tv))
!(query 100 kb (: $p (Grandmother sam_father_mother sam) $tv))
!(query 100 kb (: $p (Grandchild sam sam_father_mother) $tv))
!(query 100 kb (: $p (Grandmother sam_mother_mother sam) $tv))
!(query 100 kb (: $p (Grandchild sam sam_mother_mother) $tv))
!(query 100 kb (: $p (Flower $x) $tv))
