;; ONA examples/nal/relationalnetwork.nal (relational frame theory: same/opposite)
!(import! &self /nexus/Dev/OpenCog/NL2PLN_Project/PeTTaChainer/pettachainer/metta/petta_chainer)
!(compileadd kb (: r1 (Implication (Same $a $b) (Same $b $a)) (STV 1.0 0.9)))
!(compileadd kb (: r2 (Implication (And (Same $a $c) (Same $c $b)) (Same $a $b)) (STV 1.0 0.9)))
!(compileadd kb (: r3 (Implication (Opposite $a $b) (Opposite $b $a)) (STV 1.0 0.9)))
!(compileadd kb (: r4 (Implication (And (Opposite $a $c) (Opposite $c $b)) (Same $a $b)) (STV 1.0 0.9)))
!(compileadd kb (: r5 (Implication (And (Same $a $c) (Opposite $c $b)) (Opposite $a $b)) (STV 1.0 0.9)))
!(compileadd kb (: r6 (Implication (And (Opposite $a $c) (Same $c $b)) (Opposite $a $b)) (STV 1.0 0.9)))
!(compileadd kb (: f1 (Same A1 B1) (STV 1.0 0.9)))
!(compileadd kb (: f2 (Same A1 C1) (STV 1.0 0.9)))
!(compileadd kb (: f3 (Opposite A1 B2) (STV 1.0 0.9)))
!(compileadd kb (: f4 (Opposite A1 C2) (STV 1.0 0.9)))
;; expected (NAL): all f=1; c>= .5905 / .6561 / .6561 / .6561
!(query 200 kb (: $p (Same C1 B1) $tv))
!(query 200 kb (: $p (Same B2 C2) $tv))
!(query 200 kb (: $p (Opposite B1 C2) $tv))
!(query 200 kb (: $p (Opposite C1 B2) $tv))
