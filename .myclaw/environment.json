{
  "image": "myclaw-project-chainergame:pettachainer-live",
  "build": {
    "context": ".",
    "dockerfile": ".myclaw/Dockerfile"
  },
  "test": [
    "bash",
    "-lc",
    "/usr/local/bin/uv pip install --no-cache --python /opt/pettachainer/.venv/bin/python --no-deps --no-build-isolation -e . && /opt/pettachainer/.venv/bin/python -m unittest discover -s tests -v"
  ],
  "caches": [
    {
      "name": "pip",
      "target": "/cache/pip"
    }
  ]
}
